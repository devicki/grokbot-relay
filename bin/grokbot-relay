#!/usr/bin/env bash
# shellcheck disable=SC2015  # pass/bad/note always succeed
# grokbot-relay: install and operate the Grok Bot relay (Cursor BDK) service.
# Run `grokbot-relay help` for commands.
set -euo pipefail

APP_DIR=/opt/grokbot-relay
RELAY_DIR="$APP_DIR/relay"
HOME_DIR=/var/lib/grokbot
ENV_DIR=/etc/grokbot-relay
ENV_FILE="$ENV_DIR/env"
AGENTS_FILE="$ENV_DIR/agents.json"
SOURCE_FILE="$ENV_DIR/source"
RUNTIME_FILE="$ENV_DIR/runtime"   # NODE_MODE=private|system, NODE_BIN_DIR=... (not secret)
NODE_DIR="$APP_DIR/node"
NODE_MAJOR=24
NODE_DIST="https://nodejs.org/dist/latest-v$NODE_MAJOR.x"
DEFAULT_PORT=47800  # uncommon; not an IANA well-known/registered service port
GUM_VERSION=2.0.2   # charmbracelet/gum, private TUI binary in $APP_DIR/bin/gum
UNIT_NAME=grokbot-relay.service
UNIT="/etc/systemd/system/$UNIT_NAME"
SVC_USER=grokbot
NPM_PKG=@cursor/bdk
export NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false

die() { echo "grokbot-relay: $*" >&2; exit 1; }
info() { echo "==> $*"; }
need_root() { [[ $EUID -eq 0 ]] || die "'$1' needs root. Try: sudo grokbot-relay $1"; }

self_dir() { local p; p="$(readlink -f "${BASH_SOURCE[0]}")"; dirname "$p"; }
# Source tree containing this script (repo root or /opt copy)
script_root() { cd "$(self_dir)/.." && pwd; }

read_version() { local f="$1/VERSION"; [[ -f "$f" ]] && tr -d ' \n' < "$f" || echo unknown; }

as_svc() { sudo -u "$SVC_USER" -H env PATH="$PATH" bash -c "$1"; }

env_value() { # never print the token; only used internally
  sed -n "s/^$1=//p" "$ENV_FILE" | head -n1
}

# ---------------------------------------------------------------- node runtime
# A private Node runtime in $NODE_DIR is used by default and never added to the
# global PATH, so other accounts (nvm etc.) are unaffected. Only this script and
# the systemd unit put it first on PATH.
runtime_bin_dir() {
  local d=""
  if [[ -r "$RUNTIME_FILE" ]]; then d="$(sed -n 's/^NODE_BIN_DIR=//p' "$RUNTIME_FILE" | head -n1)"; fi
  if [[ -z "$d" && -x "$NODE_DIR/bin/node" ]]; then d="$NODE_DIR/bin"; fi
  echo "$d"
}
RT_BIN="$(runtime_bin_dir)"
[[ -n "$RT_BIN" ]] && export PATH="$RT_BIN:$PATH"

node_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo x64 ;;
    aarch64|arm64) echo arm64 ;;
    *) die "Unsupported CPU $(uname -m) for the private Node runtime. Use --node system." ;;
  esac
}

need_tools() { local t; for t in "$@"; do command -v "$t" >/dev/null || die "'$t' is required. Install it (e.g. sudo apt install $t)."; done; }

node_latest_file() { # prints tarball name of latest $NODE_MAJOR.x for this arch; SHASUMS kept in $1
  curl -fsSL "$NODE_DIST/SHASUMS256.txt" -o "$1/SHASUMS256.txt" || die "Cannot download $NODE_DIST/SHASUMS256.txt"
  grep -oE "node-v$NODE_MAJOR\.[0-9]+\.[0-9]+-linux-$(node_arch)\.tar\.gz" "$1/SHASUMS256.txt" | head -n1
}

node_fetch() { # $1 = target dir; downloads, verifies SHA256, extracts
  need_tools curl tar sha256sum
  local target="$1" tmp file
  tmp="$(mktemp -d)"
  file="$(node_latest_file "$tmp")"
  [[ -n "$file" ]] || { rm -rf "$tmp"; die "No Node $NODE_MAJOR.x tarball for $(node_arch) in SHASUMS256.txt"; }
  info "Downloading $file from nodejs.org"
  curl -fsSL "$NODE_DIST/$file" -o "$tmp/$file" || { rm -rf "$tmp"; die "Download failed: $file"; }
  ( cd "$tmp" && grep " $file\$" SHASUMS256.txt | sha256sum -c --status - ) || { rm -rf "$tmp"; die "SHA256 check FAILED for $file"; }
  info "SHA256 verified."
  tar -xzf "$tmp/$file" -C "$tmp"
  rm -rf "$target"
  mv "$tmp/${file%.tar.gz}" "$target"
  rm -rf "$tmp"
  chown -R root:"$SVC_USER" "$target"
  chmod -R g+rX,o-w "$target"
}

write_runtime() { # mode bindir
  install -d -o root -g "$SVC_USER" -m 750 "$ENV_DIR"
  printf 'NODE_MODE=%s\nNODE_BIN_DIR=%s\n' "$1" "$2" > "$RUNTIME_FILE"
  chown root:"$SVC_USER" "$RUNTIME_FILE"; chmod 644 "$RUNTIME_FILE"
  RT_BIN="$2"; export PATH="$2:$PATH"
}

setup_runtime() { # mode = private|system
  if [[ "$1" == system ]]; then
    local sys; sys="$(PATH=/usr/local/bin:/usr/bin:/bin command -v node || true)"
    [[ -n "$sys" ]] || die "--node system: no node in /usr/local/bin, /usr/bin or /bin."
    local major; major="$("$sys" -p 'process.versions.node.split(".")[0]')"
    (( major >= 22 )) || die "--node system: Node 22+ required (found $("$sys" -v))."
    write_runtime system "$(dirname "$(readlink -f "$sys")")"
    info "Using system Node $("$sys" -v) ($sys)."
  else
    if [[ -x "$NODE_DIR/bin/node" ]]; then
      info "Keeping private Node $("$NODE_DIR/bin/node" -v) in $NODE_DIR (refresh: grokbot-relay node-upgrade)."
    else
      install -d -m 755 "$APP_DIR"
      node_fetch "$NODE_DIR"
      info "Installed private Node $("$NODE_DIR/bin/node" -v) in $NODE_DIR (not on the global PATH)."
    fi
    write_runtime private "$NODE_DIR/bin"
  fi
}

gum_fetch() { # best effort: private gum for the TUI; never fatal
  local arch tmp file base
  case "$(uname -m)" in x86_64|amd64) arch=x86_64 ;; aarch64|arm64) arch=arm64 ;; *) return 0 ;; esac
  command -v curl >/dev/null && command -v sha256sum >/dev/null || return 0
  base="https://github.com/charmbracelet/gum/releases/download/v$GUM_VERSION"
  file="gum_${GUM_VERSION}_Linux_${arch}.tar.gz"
  tmp="$(mktemp -d)"
  if curl -fsSL "$base/checksums.txt" -o "$tmp/checksums.txt" && curl -fsSL "$base/$file" -o "$tmp/$file" \
     && ( cd "$tmp" && grep " $file\$" checksums.txt | sha256sum -c --status - ); then
    tar -xzf "$tmp/$file" -C "$tmp"
    install -o root -g root -m 755 "$tmp/${file%.tar.gz}/gum" "$APP_DIR/bin/gum"
    info "Installed gum $GUM_VERSION for the TUI (private, not on the global PATH)."
  else
    echo "note: gum download/verify failed; the TUI will use whiptail or plain menus." >&2
  fi
  rm -rf "$tmp"
}

ensure_gum() { [[ -x "$APP_DIR/bin/gum" ]] || gum_fetch; }

port_in_use() { # 0 if something listens on TCP port $1 (any address)
  if command -v ss >/dev/null; then
    [[ -n "$(ss -Htln "sport = :$1" 2>/dev/null)" ]]
  else
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
  fi
}

next_free_port() { # first free port starting at $1
  local p="$1"
  while port_in_use "$p" && (( p < 65535 )); do p=$((p+1)); done
  echo "$p"
}

install_unit() { # $1 = source root
  local p="$RT_BIN:/usr/bin:/bin"
  sed "s|^Environment=PATH=.*|Environment=PATH=$p|" "$1/deploy/$UNIT_NAME" > "$UNIT"
  chown root:root "$UNIT"; chmod 644 "$UNIT"
}

installed_bdk() {
  [[ -f "$RELAY_DIR/node_modules/$NPM_PKG/package.json" ]] || { echo none; return; }
  node -p "require('$RELAY_DIR/node_modules/$NPM_PKG/package.json').version"
}

copy_app() { # $1 = source repo root
  local src="$1"
  [[ -d "$src/relay" ]] || die "$src does not look like a grokbot-relay clone (no relay/)."
  install -d -m 755 "$APP_DIR"
  local new="$APP_DIR/relay.new"
  rm -rf "$new"
  cp -a "$src/relay" "$new"
  rm -rf "$new/node_modules" "$new/.agent-serve" "$new/memory"
  if [[ -d "$RELAY_DIR/node_modules" ]]; then mv "$RELAY_DIR/node_modules" "$new/"; fi
  rm -rf "$RELAY_DIR"
  mv "$new" "$RELAY_DIR"
  local gum_keep=""
  if [[ -x "$APP_DIR/bin/gum" ]]; then gum_keep="$(mktemp)"; cp -p "$APP_DIR/bin/gum" "$gum_keep"; fi
  rm -rf "${APP_DIR:?}/bin" && cp -a "$src/bin" "$APP_DIR/bin"
  rm -f "$APP_DIR/bin/gum"
  if [[ -n "$gum_keep" ]]; then mv "$gum_keep" "$APP_DIR/bin/gum"; fi
  rm -rf "${APP_DIR:?}/deploy" && cp -a "$src/deploy" "$APP_DIR/deploy"
  cp "$src/VERSION" "$APP_DIR/VERSION"
  cp "$src/agents.example.json" "$APP_DIR/agents.example.json"
  chown root:root "$APP_DIR"; chmod 755 "$APP_DIR"
  chown -R root:root "$APP_DIR/bin" "$APP_DIR/deploy" "$APP_DIR/VERSION" "$APP_DIR/agents.example.json"
  chmod -R go+rX,go-w "$APP_DIR/bin" "$APP_DIR/deploy"
  # relay: owned by the service user, readable by the grokbot group (connect-claude runs bdk from here)
  chown -R "$SVC_USER:$SVC_USER" "$RELAY_DIR"
  chmod -R g+rX,g-w,o-rwx "$RELAY_DIR"
}

NPM_ENV="NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false"
npm_ci() {
  if [[ -f "$RELAY_DIR/package-lock.json" ]]; then
    as_svc "cd '$RELAY_DIR' && $NPM_ENV npm ci --no-audit --no-fund"
  else
    as_svc "cd '$RELAY_DIR' && $NPM_ENV npm install --no-audit --no-fund"
  fi
  npm_rebuild
}

# npm 11.16+ gates dependency install scripts on package.json "allowScripts"
# (esbuild, protobufjs allowed; @cursor/bdk optional skill installer denied).
# Older npm ignores the field and runs them anyway. Rebuild explicitly in case
# an earlier install skipped them.
npm_rebuild() {
  as_svc "cd '$RELAY_DIR' && $NPM_ENV npm rebuild --loglevel=error esbuild protobufjs" >/dev/null \
    || echo "warning: npm rebuild esbuild protobufjs failed; run: sudo grokbot-relay doctor" >&2
}

esbuild_ok() {
  as_svc "cd '$RELAY_DIR' && node -e \"require('esbuild').transformSync('let a=1')\"" >/dev/null 2>&1
}

validate_relay() {
  as_svc "cd '$RELAY_DIR' && set -a && . '$ENV_FILE' && set +a && GROKBOT_RELAY_AGENTS_FILE='$AGENTS_FILE' ./node_modules/.bin/bdk validate </dev/null"
}

restart_if_active() {
  if systemctl is-active --quiet "$UNIT_NAME"; then
    systemctl restart "$UNIT_NAME"; info "Restarted $UNIT_NAME."
  else
    info "$UNIT_NAME is not running; start it with: sudo grokbot-relay start"
  fi
}

# ---------------------------------------------------------------- install
cmd_install() {
  need_root install
  local port="" node_mode=private
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="${2:?--port needs a number}"; shift 2 ;;
      --node) node_mode="${2:?--node needs private or system}"; shift 2 ;;
      --tui) load_tui; tui_wizard; return ;;
      *) die "install: unknown option $1" ;;
    esac
  done
  local src; src="$(script_root)"
  [[ "$src" == "$APP_DIR" ]] && [[ -f "$SOURCE_FILE" ]] && src="$(cat "$SOURCE_FILE")"

  [[ "$node_mode" == private || "$node_mode" == system ]] || die "--node must be private or system."

  getent group "$SVC_USER" >/dev/null || groupadd --system "$SVC_USER"
  if ! id "$SVC_USER" >/dev/null 2>&1; then
    useradd --system --gid "$SVC_USER" --home-dir "$HOME_DIR" --create-home --shell /usr/sbin/nologin "$SVC_USER"
  fi
  install -d -o "$SVC_USER" -g "$SVC_USER" -m 750 "$HOME_DIR" "$HOME_DIR/state"

  setup_runtime "$node_mode"

  info "Copying relay from $src to $APP_DIR"
  copy_app "$src"
  npm_ci

  install -d -o root -g "$SVC_USER" -m 750 "$ENV_DIR"
  if [[ ! -f "$ENV_FILE" ]]; then
    local want="${port:-$DEFAULT_PORT}"
    [[ "$want" =~ ^[0-9]+$ ]] && (( want > 0 && want < 65536 )) || die "Invalid port: $want"
    port="$(next_free_port "$want")"
    [[ "$port" != "$want" ]] && info "Port $want is already in use; using $port instead."
    local token
    token="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
    ( umask 077; printf 'GROKBOT_RELAY_PORT=%s\nGROKBOT_RELAY_TOKEN=%s\n' "$port" "$token" > "$ENV_FILE" )
    unset token
    info "Created $ENV_FILE (token not shown)."
  else
    [[ -n "$port" ]] && info "Ignoring --port $port: keeping the configured port $(env_value GROKBOT_RELAY_PORT) (edit $ENV_FILE to change it)."
    info "$ENV_FILE exists; kept as is."
  fi
  chown root:"$SVC_USER" "$ENV_FILE"; chmod 640 "$ENV_FILE"

  if [[ ! -f "$AGENTS_FILE" ]]; then
    install -o root -g "$SVC_USER" -m 640 "$src/agents.example.json" "$AGENTS_FILE"
    info "Created $AGENTS_FILE from agents.example.json. EDIT IT before starting."
  else
    info "$AGENTS_FILE exists; kept as is."
  fi
  chown root:"$SVC_USER" "$AGENTS_FILE"; chmod 640 "$AGENTS_FILE"

  printf '%s\n' "$src" > "$SOURCE_FILE"; chmod 644 "$SOURCE_FILE"

  ensure_gum
  chmod 755 "$APP_DIR/bin/gum" 2>/dev/null || true
  install_unit "$src"
  systemctl daemon-reload
  systemctl enable "$UNIT_NAME" >/dev/null
  ln -sf "$APP_DIR/bin/grokbot-relay" /usr/local/bin/grokbot-relay

  cat <<NEXT

Installed grokbot-relay $(read_version "$APP_DIR"). Not started yet. Next steps:
  1) Set your bot names (exactly as shown in the Grok Bot app):
       sudo grokbot-relay agents edit        # or: agents add "<name>"
  2) Sign in to Cursor as the service user:
       sudo grokbot-relay login
  3) Start and check:
       sudo grokbot-relay start
       sudo grokbot-relay doctor
  4) Allow regular users to connect (they log out and back in):
       sudo usermod -aG $SVC_USER <user>
     then each user runs: grokbot-relay connect-claude
NEXT
}

# ---------------------------------------------------------------- service
cmd_login() {
  need_root login
  [[ -d "$RELAY_DIR" ]] || die "Not installed. Run: sudo grokbot-relay install"
  info "$LOGIN_HINT"
  as_svc "cd '$RELAY_DIR' && ./node_modules/.bin/bdk login"
}

# Color the "Active:" line: green running, red failed, yellow inactive/activating/other.
# Off with NO_COLOR or --plain; on for a terminal, or when the TUI captures output (GRB_COLOR=1).
color_active() {
  if [[ -n "${NO_COLOR:-}" || "${GRB_PLAIN:-0}" == 1 ]] || { [[ ! -t 1 ]] && [[ "${GRB_COLOR:-0}" != 1 ]]; }; then cat; return; fi
  local e=$'\e' line c
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*Active: ]]; then
      case "$line" in
        *"active (running)"*) c=32 ;;
        *failed*) c=31 ;;
        *) c=33 ;;
      esac
      printf '%s[1;%sm%s%s[0m\n' "$e" "$c" "$line" "$e"
    else printf '%s\n' "$line"; fi
  done
}
cmd_svc() { need_root "$1"; systemctl "$1" "$UNIT_NAME"; [[ "$1" == start || "$1" == restart ]] && { systemctl --no-pager --lines=0 status "$UNIT_NAME" | color_active; } || true; }
cmd_status() { { systemctl --no-pager status "$UNIT_NAME" || true; } | color_active; }
cmd_logs() {
  local args=(-u "$UNIT_NAME" --no-pager -n 100)
  [[ "${1:-}" == "-f" ]] && args+=(-f)
  journalctl "${args[@]}"
}

# ---------------------------------------------------------------- update
cmd_update() {
  need_root update
  [[ -f "$SOURCE_FILE" ]] || die "No source recorded ($SOURCE_FILE). Re-run install from your clone."
  local src old new
  src="$(cat "$SOURCE_FILE")"
  [[ -n "$RT_BIN" && -x "$RT_BIN/node" ]] || die "Node runtime missing. Re-run: sudo grokbot-relay install (or node-upgrade)."
  [[ -d "$src/.git" ]] || die "$src is not a git clone."
  old="$(read_version "$APP_DIR")"
  local owner; owner="$(stat -c %U "$src")"
  info "git pull in $src (as $owner)"
  sudo -u "$owner" git -C "$src" pull --ff-only
  new="$(read_version "$src")"
  copy_app "$src"
  npm_ci
  ensure_gum
  install_unit "$src"
  systemctl daemon-reload
  info "Kept $ENV_FILE and $AGENTS_FILE."
  restart_if_active
  info "Version: $old -> $new"
}

# ---------------------------------------------------------------- bdk
cmd_bdk_check() {
  local cur latest
  cur="$(installed_bdk)"
  latest="$(npm view "$NPM_PKG" version 2>/dev/null || echo unknown)"
  echo "installed $NPM_PKG: $cur"
  echo "latest    $NPM_PKG: $latest"
  if [[ "$cur" != "$latest" && "$latest" != unknown ]]; then
    echo "An update is available: sudo grokbot-relay bdk-upgrade"
  else
    echo "Up to date."
  fi
  local repo
  repo="$(npm view "$NPM_PKG" repository.url 2>/dev/null || true)"
  echo "npm page:  https://www.npmjs.com/package/$NPM_PKG?activeTab=versions"
  [[ -n "$repo" ]] && echo "repository: $repo"
  echo "docs:      https://cursor.com/docs/bdk"
}

cmd_bdk_upgrade() {
  need_root bdk-upgrade
  local pin=0
  [[ "${1:-}" == "--pin" ]] && pin=1
  [[ -d "$RELAY_DIR" ]] || die "Not installed."
  local old new bak
  old="$(installed_bdk)"
  bak="$(mktemp -d)"
  cp "$RELAY_DIR/package.json" "$RELAY_DIR/package-lock.json" "$bak/" 2>/dev/null || true
  info "Upgrading $NPM_PKG ($old -> latest)"
  if ! as_svc "cd '$RELAY_DIR' && $NPM_ENV npm install --no-audit --no-fund $NPM_PKG@latest"; then
    die "npm install failed; nothing changed in the running service."
  fi
  npm_rebuild
  new="$(installed_bdk)"
  if validate_relay; then
    info "bdk validate passed ($old -> $new)."
    restart_if_active
  else
    echo "bdk validate FAILED on $new. Rolling back to $old." >&2
    cp "$bak/package.json" "$RELAY_DIR/package.json"
    [[ -f "$bak/package-lock.json" ]] && cp "$bak/package-lock.json" "$RELAY_DIR/package-lock.json"
    chown "$SVC_USER:$SVC_USER" "$RELAY_DIR/package.json" "$RELAY_DIR/package-lock.json"
    npm_ci
    rm -rf "$bak"
    exit 1
  fi
  if (( pin )); then
    local src owner; src="$(cat "$SOURCE_FILE")"; owner="$(stat -c %U "$src")"
    install -o "$owner" -m 644 "$RELAY_DIR/package.json" "$src/relay/package.json"
    install -o "$owner" -m 644 "$RELAY_DIR/package-lock.json" "$src/relay/package-lock.json"
    info "Wrote package.json/package-lock.json into $src/relay."
  fi
  rm -rf "$bak"
  cat <<UP

To share this bump upstream:
  cd <your clone>              # recorded in $SOURCE_FILE
  sudo grokbot-relay bdk-upgrade --pin   # (or copy relay/package*.json from $RELAY_DIR)
  git checkout -b bdk-$new
  git commit -am "relay: bump $NPM_PKG to $new"
  git push -u origin bdk-$new  # then open a pull request
UP
}

# ---------------------------------------------------------------- node-upgrade
cmd_node_upgrade() {
  need_root node-upgrade
  if [[ -r "$RUNTIME_FILE" ]] && grep -q '^NODE_MODE=system' "$RUNTIME_FILE"; then
    die "This install uses the system Node ($RT_BIN). Upgrade it with your package manager, or reinstall with --node private."
  fi
  need_tools curl tar sha256sum
  local cur latest tmp
  cur="$([[ -x "$NODE_DIR/bin/node" ]] && "$NODE_DIR/bin/node" -v || echo none)"
  tmp="$(mktemp -d)"; latest="$(node_latest_file "$tmp")"; rm -rf "$tmp"
  latest="${latest#node-}"; latest="${latest%%-linux*}"
  echo "private Node: $cur   latest $NODE_MAJOR.x: $latest"
  if [[ "$cur" == "$latest" ]]; then echo "Up to date."; return 0; fi
  node_fetch "$NODE_DIR.new"
  rm -rf "$NODE_DIR.old"; [[ -d "$NODE_DIR" ]] && mv "$NODE_DIR" "$NODE_DIR.old"
  mv "$NODE_DIR.new" "$NODE_DIR"
  write_runtime private "$NODE_DIR/bin"
  if [[ -d "$RELAY_DIR/node_modules" ]]; then npm_rebuild; fi
  if [[ -d "$RELAY_DIR/node_modules" ]] && ! validate_relay >/dev/null 2>&1; then
    echo "bdk validate failed on the new Node; rolling back to $cur." >&2
    rm -rf "$NODE_DIR"; mv "$NODE_DIR.old" "$NODE_DIR"; npm_rebuild; exit 1
  fi
  rm -rf "$NODE_DIR.old"
  info "Node: $cur -> $("$NODE_DIR/bin/node" -v)"
  restart_if_active
}

# ---------------------------------------------------------------- agents
agents_js() { # $1 = op, $2 = name
  node - "$AGENTS_FILE" "$1" "${2:-}" <<'JS'
const fs = require("fs");
const [file, op, name] = process.argv.slice(2);
let data = { agents: [] };
try { data = JSON.parse(fs.readFileSync(file, "utf8")); } catch (e) { if (op !== "add") { console.error(`cannot read ${file}: ${e.message}`); process.exit(2); } }
if (!Array.isArray(data.agents)) data.agents = [];
const names = () => data.agents.map((a) => (typeof a === "string" ? a : a.name));
if (op === "list") { const n = names(); if (!n.length) console.log("(empty: the relay will refuse to start)"); n.forEach((x) => console.log(x)); process.exit(0); }
const nm = (name || "").trim();
if (!nm || nm === "*") { console.error("invalid name"); process.exit(2); }
if (op === "add") { if (names().includes(nm)) { console.log(`already listed: ${nm}`); process.exit(3); } data.agents.push({ name: nm }); }
if (op === "remove") {
  if (!names().includes(nm)) { console.error(`not listed: ${nm}`); process.exit(2); }
  const rest = data.agents.filter((a) => (typeof a === "string" ? a : a.name) !== nm);
  if (!rest.length) { console.error("refusing to remove the last agent: the list must not be empty"); process.exit(2); }
  data.agents = rest;
}
fs.writeFileSync(file, JSON.stringify(data, null, 2) + "\n");
console.log(`${op === "add" ? "added" : "removed"}: ${nm}`);
JS
}

# Replace the allowlist with the names on stdin (one per line); keeps existing descriptions.
agents_set() {
  local names; names="$(cat)"
  node - "$AGENTS_FILE" "$names" <<'JS'
const fs = require("fs");
const file = process.argv[2];
let old = { agents: [] };
try { old = JSON.parse(fs.readFileSync(file, "utf8")); } catch {}
const desc = new Map((old.agents || []).map((a) => (typeof a === "string" ? [a, undefined] : [a.name, a.description])));
const names = [...new Set((process.argv[3] || "").split("\n").map((s) => s.trim()).filter((s) => s && s !== "*"))];
if (!names.length) { console.error("refusing to save an empty list"); process.exit(2); }
const agents = names.map((n) => (desc.get(n) ? { name: n, description: desc.get(n) } : { name: n }));
fs.writeFileSync(file, JSON.stringify({ ...old, agents }, null, 2) + "\n");
console.log(`saved ${names.length} bot(s): ${names.join(", ")}`);
JS
  chown root:"$SVC_USER" "$AGENTS_FILE"; chmod 640 "$AGENTS_FILE"
}

# List the bots on the signed-in Cursor account.
# Not possible today: @cursor/bdk 0.2.25 talks to Grok Bot only through the
# /v0/grokbot session routes (create-or-get a session by name, send, read
# entries, interrupt) and grokbot__list returns only configured and already
# contacted names. There is no account-wide list route. Kept as one hook so a
# future listing API slots in here (print one name per line, return 0).
fetch_account_bots() {
  echo "Your Grok Bot list can't be read through Cursor's API yet (@cursor/bdk $(installed_bdk) has no list route). Type names exactly as shown in the Grok Bot app." >&2
  return 1
}

agents_check_nonempty() {
  node -e 'const d=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));const n=(d.agents||[]).map(a=>typeof a==="string"?a:a&&a.name).filter(x=>x&&x.trim()&&x!=="*");if(!n.length){process.exit(1)}' "$AGENTS_FILE"
}

BOTS_NOTE="Unchecked or removed bots are only removed from this relay's allowlist — your bots in the Grok Bot app are not deleted."
LOGIN_HINT="bdk login prints a sign-in URL and waits. No browser is needed on this server: copy the URL into a browser on any computer (works over SSH), sign in, and this command finishes on its own. The 'Opening your browser' line is harmless on a headless server. Alternative: an API key from the Cursor dashboard (bdk login --api-key)."

cmd_agents() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list)
      [[ -r "$AGENTS_FILE" ]] || die "Cannot read $AGENTS_FILE (need root or grokbot group)."
      agents_js list ;;
    pick)
      need_root "agents pick"
      [[ -t 0 && -t 1 ]] || die "agents pick needs a terminal; use: agents add NAME"
      load_tui; t_agents_pick ;;
    add|remove)
      need_root "agents $sub"
      if [[ -z "${1:-}" && "$sub" == add && -t 0 && -t 1 ]]; then load_tui; t_agents_pick; return; fi
      [[ -n "${1:-}" ]] || die "usage: grokbot-relay agents $sub \"<name>\"   (or: agents pick)"
      [[ "$sub" == remove ]] && info "$BOTS_NOTE"
      local rc=0; agents_js "$sub" "$1" || rc=$?
      (( rc == 3 )) && return 0
      (( rc == 0 )) || exit "$rc"
      chown root:"$SVC_USER" "$AGENTS_FILE"; chmod 640 "$AGENTS_FILE"
      restart_if_active ;;
    edit)
      need_root "agents edit"
      local tmp; tmp="$(mktemp)"; cp "$AGENTS_FILE" "$tmp"
      "${EDITOR:-nano}" "$tmp"
      if ! node -e 'JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"))' "$tmp" 2>/dev/null; then
        rm -f "$tmp"; die "Invalid JSON; $AGENTS_FILE unchanged."
      fi
      local saved="$AGENTS_FILE"; AGENTS_FILE="$tmp"
      if ! agents_check_nonempty; then AGENTS_FILE="$saved"; rm -f "$tmp"; die "The list is empty; $saved unchanged."; fi
      AGENTS_FILE="$saved"
      install -o root -g "$SVC_USER" -m 640 "$tmp" "$AGENTS_FILE"; rm -f "$tmp"
      info "Saved $AGENTS_FILE."
      restart_if_active ;;
    *) die "usage: grokbot-relay agents list|pick|add [NAME]|remove NAME|edit" ;;
  esac
}

# ---------------------------------------------------------------- doctor
cmd_doctor() {
  local ok=0 warn=0
  pass() { echo "  [ok]   $*"; ok=$((ok+1)); }
  bad()  { echo "  [FAIL] $*"; warn=$((warn+1)); }
  note() { echo "  [info] $*"; }
  echo "grokbot-relay $(read_version "$APP_DIR") doctor"

  if [[ -n "$RT_BIN" && -x "$RT_BIN/node" ]]; then
    local m mode=private; m="$("$RT_BIN/node" -p 'process.versions.node.split(".")[0]')"
    [[ -r "$RUNTIME_FILE" ]] && grep -q '^NODE_MODE=system' "$RUNTIME_FILE" && mode=system
    (( m >= 22 )) && pass "node $("$RT_BIN/node" -v) ($mode runtime: $RT_BIN)" || bad "node $("$RT_BIN/node" -v) at $RT_BIN (need 22+)"
    [[ $mode == private ]] && note "private runtime is not on the global PATH (by design); refresh: sudo grokbot-relay node-upgrade"
  else bad "Node runtime not found (sudo grokbot-relay install)"; fi

  [[ -d "$RELAY_DIR/node_modules" ]] && pass "app installed in $RELAY_DIR" || bad "app not installed (sudo grokbot-relay install)"
  note "$NPM_PKG $(installed_bdk) (latest check: grokbot-relay bdk-check)"
  if [[ $EUID -eq 0 && -d "$RELAY_DIR/node_modules" ]]; then
    esbuild_ok && pass "esbuild works" || bad "esbuild NOT working: the relay cannot load TypeScript. Fix: sudo grokbot-relay update (reinstalls and rebuilds). Check: cd $RELAY_DIR && sudo -u grokbot npm rebuild esbuild"
  else note "esbuild check needs root"; fi

  systemctl is-enabled --quiet "$UNIT_NAME" 2>/dev/null && pass "service enabled at boot" || note "service not enabled at boot"
  systemctl is-active --quiet "$UNIT_NAME" 2>/dev/null && pass "service running" || bad "service not running"

  for f in "$ENV_FILE" "$AGENTS_FILE"; do
    if [[ -e "$f" ]]; then
      local perm own; perm="$(stat -c %a "$f")"; own="$(stat -c %U:%G "$f")"
      [[ "$perm" == 640 && "$own" == "root:$SVC_USER" ]] && pass "$f ($perm $own)" || bad "$f is $perm $own (want 640 root:$SVC_USER)"
    else bad "$f missing"; fi
  done

  if [[ -r "$AGENTS_FILE" ]]; then
    agents_check_nonempty && pass "agents list not empty ($(agents_js list | wc -l))" || bad "agents list empty (relay refuses to start)"
  else note "cannot read $AGENTS_FILE without root/grokbot group"; fi

  if [[ -r "$ENV_FILE" ]]; then
    local port; port="$(env_value GROKBOT_RELAY_PORT)"
    [[ -n "$(env_value GROKBOT_RELAY_TOKEN)" ]] && pass "token set (not shown)" || bad "token missing in $ENV_FILE"
    if command -v ss >/dev/null; then
      if ss -ltn "sport = :$port" | grep -q "127.0.0.1:$port"; then pass "listening on 127.0.0.1:$port"
      elif ss -ltn "sport = :$port" | grep -q ":$port"; then bad "port $port is listening but not only on 127.0.0.1"
      elif port_in_use "$port"; then bad "port $port is used by something else"
      else bad "nothing listening on 127.0.0.1:$port"; fi
      if ! systemctl is-active --quiet "$UNIT_NAME" 2>/dev/null && port_in_use "$port"; then
        note "port $port is taken by another program; pick a free one (e.g. $(next_free_port "$port")) in $ENV_FILE, then restart"
      fi
    else note "ss not found; skipped port check"; fi
  else note "cannot read $ENV_FILE without root/grokbot group"; fi

  if [[ $EUID -eq 0 && -d "$RELAY_DIR/node_modules" ]]; then
    if as_svc "cd '$RELAY_DIR' && timeout 20 ./node_modules/.bin/bdk whoami </dev/null" >/dev/null 2>&1; then
      pass "Cursor login present (bdk whoami)"
    else bad "Cursor login not detected (sudo grokbot-relay login)"; fi
  else note "login check needs root"; fi

  echo "$ok ok, $warn problem(s)"
  (( warn == 0 ))
}

# ---------------------------------------------------------------- uninstall
ask_yn() { # question -> 0 yes; no terminal = no
  [[ -t 0 ]] || return 1
  local a; read -r -p "$1 [y/N] " a; [[ "$a" =~ ^[Yy] ]]
}

cmd_uninstall() {
  need_root uninstall
  local purge=0 keep=0 yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --purge) purge=1 ;;
      --keep-config) keep=1 ;;
      -y|--yes) yes=1 ;;
      *) die "uninstall: unknown option $1 (use --purge, --keep-config, -y)" ;;
    esac
    shift
  done
  (( purge && keep )) && die "uninstall: --purge and --keep-config cannot be combined."
  local src=""; [[ -f "$SOURCE_FILE" ]] && src="$(cat "$SOURCE_FILE")"

  echo "grokbot-relay uninstall will remove:"
  echo "  - service $UNIT_NAME (stop, disable, $UNIT, daemon-reload)"
  echo "  - $APP_DIR"
  echo "  - /usr/local/bin/grokbot-relay"
  echo "  - $SOURCE_FILE"
  echo "  - private Node runtime $NODE_DIR and gum (inside $APP_DIR)"
  if (( purge )); then
    echo "  - $ENV_DIR (token, agents.json)"
    echo "  - $HOME_DIR (Cursor login, state)"
    echo "  - user and group $SVC_USER"
  elif (( keep )); then
    echo "Kept: $ENV_DIR (token, agents.json). Asked separately: $HOME_DIR, user/group $SVC_USER."
  else
    echo "Asked separately: $ENV_DIR (token, agents.json), $HOME_DIR (Cursor login), user/group $SVC_USER."
  fi
  echo "Never touched: the source clone${src:+ ($src)}, and your bots in the Grok Bot app (only this relay's local allowlist goes away)."
  if (( ! yes )); then
    ask_yn "Proceed?" || { echo "Cancelled."; return 1; }
  fi

  systemctl stop "$UNIT_NAME" 2>/dev/null || true
  systemctl disable "$UNIT_NAME" 2>/dev/null || true
  rm -f "$UNIT"; systemctl daemon-reload
  rm -rf "${APP_DIR:?}"
  rm -f /usr/local/bin/grokbot-relay "$SOURCE_FILE"
  info "Removed service, $APP_DIR and the CLI link."

  local rm_cfg=0 rm_home=0 rm_user=0
  if (( purge )); then rm_cfg=1; rm_home=1; rm_user=1
  else
    if (( ! keep )) && [[ -d "$ENV_DIR" ]]; then ask_yn "Delete $ENV_DIR (token and agents.json)?" && rm_cfg=1; fi
    if [[ -d "$HOME_DIR" ]]; then ask_yn "Delete $HOME_DIR (Cursor login and state)?" && rm_home=1; fi
    if id "$SVC_USER" >/dev/null 2>&1; then ask_yn "Remove user and group $SVC_USER?" && rm_user=1; fi
  fi
  (( rm_cfg )) && { rm -rf "${ENV_DIR:?}"; info "Removed $ENV_DIR."; }
  (( rm_home )) && { rm -rf "${HOME_DIR:?}"; info "Removed $HOME_DIR."; }
  if (( rm_user )); then
    id "$SVC_USER" >/dev/null 2>&1 && userdel "$SVC_USER" 2>/dev/null || true
    getent group "$SVC_USER" >/dev/null && groupdel "$SVC_USER" 2>/dev/null || true
    info "Removed user/group $SVC_USER."
  fi
  [[ -d "$ENV_DIR" ]] && echo "Kept $ENV_DIR."
  [[ -d "$HOME_DIR" ]] && echo "Kept $HOME_DIR."
  id "$SVC_USER" >/dev/null 2>&1 && echo "Kept user $SVC_USER."

  echo
  echo "Uninstalled. To reinstall:"
  if [[ -n "$src" && -d "$src" ]]; then
    echo "  cd $src && sudo ./bin/grokbot-relay install --tui"
  else
    echo "  git clone https://github.com/devicki/grokbot-relay && cd grokbot-relay && sudo ./bin/grokbot-relay install --tui"
  fi
  return 0
}

# ---------------------------------------------------------------- connect
cmd_connect_claude() {
  [[ $EUID -ne 0 ]] || die "Run connect-claude as your regular user, not root."
  local scope=user
  [[ "${1:-}" == "--scope" && -n "${2:-}" ]] && scope="$2"
  command -v claude >/dev/null || die "Claude Code (claude) not found."
  [[ -r "$ENV_FILE" ]] || die "Cannot read $ENV_FILE. Ask the admin: sudo usermod -aG $SVC_USER $USER (then log in again)."
  [[ -n "$(env_value GROKBOT_RELAY_PORT)" && -n "$(env_value GROKBOT_RELAY_TOKEN)" ]] || die "$ENV_FILE is missing values."
  [[ -n "$RT_BIN" && -x "$RT_BIN/node" ]] || die "Relay Node runtime not readable ($RUNTIME_FILE). Ask the admin to run: sudo grokbot-relay doctor"
  [[ -r "$RELAY_DIR/node_modules/.bin/bdk" ]] || die "Cannot read $RELAY_DIR/node_modules (need grokbot group; log out and back in after usermod)."
  claude mcp remove grokbot --scope "$scope" >/dev/null 2>&1 || true
  # Uses the relay's own Node runtime and installed bdk, so it does not depend on your nvm/PATH.
  # The token is read from the env file each time the server starts; it is not stored in Claude Code's config.
  # shellcheck disable=SC2016
  claude mcp add grokbot --scope "$scope" -- bash -c \
    '. /etc/grokbot-relay/runtime; set -a; . /etc/grokbot-relay/env; set +a; exec "${NODE_BIN_DIR}/node" /opt/grokbot-relay/relay/node_modules/.bin/bdk mcp --url "http://127.0.0.1:${GROKBOT_RELAY_PORT}" --bearer-token "${GROKBOT_RELAY_TOKEN}"'
  echo "Registered MCP server 'grokbot' (scope: $scope). Check with: claude mcp list"
}

load_tui() {
  # shellcheck source=lib/tui.sh
  . "$(self_dir)/lib/tui.sh"
}

cmd_help() {
  cat <<'H'
grokbot-relay: install and operate the Grok Bot relay (Cursor BDK) service

Setup (root)
  (no args) | tui           open the menu (TUI) on a terminal (gum; falls back to whiptail/plain)
  --plain <cmd>             plain prompts, no colors (also: NO_COLOR=1)
  install [--port N] [--node private|system] [--tui]
                            install or reinstall; private Node 24 runtime by default
                            (downloaded from nodejs.org, SHA256-checked, not on global PATH);
                            --tui runs the setup wizard
  login                     Cursor sign-in as the grokbot user (bdk login)
  update                    git pull the source clone, recopy, npm ci, restart; keeps env/agents
Service (root, except status/logs)
  start | stop | restart    control the service
  status                    systemctl status
  logs [-f]                 recent logs (follow with -f)
  enable | disable          start at boot or not
Agents
  agents list               show allowed bot names
  agents pick               choose bots in a multi-select, plus manual entry (root, terminal)
  agents add [NAME]         add a name (root), restarts if running; no NAME on a terminal = pick
  agents remove NAME        remove a name (root); the last one cannot be removed
  agents edit               edit agents.json in $EDITOR (root), validated before saving
BDK
  node-upgrade              refresh the private Node runtime to the latest 24.x (root)
  bdk-check                 compare installed @cursor/bdk with npm latest
  bdk-upgrade [--pin]       upgrade @cursor/bdk, validate, restart or roll back (root);
                            --pin also writes package*.json into the source clone for a PR
Other
  uninstall [--purge|--keep-config] [-y]  remove service, /opt app, CLI link (root);
                            asks before config, login/state, and the grokbot user
  doctor                    health checks (node, service, files, port, login, bdk)
  connect-claude [--scope user|local]   register the relay in Claude Code (regular user in grokbot group)
  version | help
H
}

main() {
  if [[ "${1:-}" == --plain ]]; then export GRB_PLAIN=1; shift; fi
  local cmd="${1:-}"; shift || true
  if [[ -z "$cmd" ]]; then
    if [[ -t 0 && -t 1 ]]; then cmd=tui; else cmd=help; fi
  fi
  case "$cmd" in
    tui) load_tui; tui_main ;;
    install) cmd_install "$@" ;;
    login) cmd_login ;;
    start|stop|restart|enable|disable) cmd_svc "$cmd" ;;
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    update) cmd_update ;;
    bdk-check) cmd_bdk_check ;;
    bdk-upgrade) cmd_bdk_upgrade "$@" ;;
    agents) cmd_agents "$@" ;;
    doctor) cmd_doctor ;;
    uninstall) cmd_uninstall "$@" ;;
    node-upgrade) cmd_node_upgrade ;;
    connect-claude) cmd_connect_claude "$@" ;;
    version|--version|-v) echo "grokbot-relay $(read_version "$(script_root)")" ;;
    help|--help|-h) cmd_help ;;
    *) echo "unknown command: $cmd" >&2; cmd_help >&2; exit 2 ;;
  esac
}

main "$@"
