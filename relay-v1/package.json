{
  "name": "grokbot-relay-v1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "v1 relay. HTTP client for /v0/grokbot on Agent SDK 0.3. Does not import cursor-grokbot-agents.",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "validate": "agent-sdk validate --dir . --json",
    "dev": "agent-sdk dev"
  },
  "dependencies": {
    "@grok/agent-sdk": "0.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.20.6",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": true,
    "@grok/agent-sdk": false
  }
}
